# Augur environment configuration
# Copy to .env and fill in values before running.
# Never commit the .env file.

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string for the application
DATABASE_URL=postgresql+asyncpg://augur:changeme@db:5432/augur
# Postgres credentials (used by docker-compose to initialise the DB)
POSTGRES_USER=augur
POSTGRES_PASSWORD=changeme
POSTGRES_DB=augur

# ── OpenRouter API keys ───────────────────────────────────────────────────────
# Main key — used by the signal pipeline (ingestion, extraction, anchoring,
# disconfirmation). Model access is not restricted on this key.
OPENROUTER_API_KEY=sk-or-v1-...

# Free-tier key — reserved for reader-facing text that must cost nothing: the
# conversation layer and the dimension digest notes.
# Restrict this key on the OpenRouter dashboard to free-tier models only.
OPENROUTER_FREE_TIER_API_KEY=sk-or-v1-...

# LLM calls are recorded in the llm_calls table (`augur llm-calls`); there is
# no separate observability service to configure.  Optionally, switch on
# OpenRouter Broadcast (Settings > Observability on openrouter.ai): every
# request carries trace_id = llm_calls.call_id, so its traces join back here.

# ── SearXNG ───────────────────────────────────────────────────────────────────
# Meta-search instance running on the same VPS.
SEARXNG_URL=http://searxng:8080

# ── Object storage (backups) ──────────────────────────────────────────────────
# Hetzner Object Storage or Backblaze B2 (S3-compatible).
OBJECT_STORAGE_ENDPOINT=https://fsn1.your-objectstorage.com
OBJECT_STORAGE_BUCKET=augur-backups
OBJECT_STORAGE_ACCESS_KEY=...
OBJECT_STORAGE_SECRET_KEY=...
OBJECT_STORAGE_REGION=eu-central

# ── Cost / budget ─────────────────────────────────────────────────────────────
# Daily LLM spend cap for the main pipeline key (USD).
# The LLM client will refuse calls once this is exceeded.
DAILY_LLM_BUDGET_USD=5.00

# ── LLM models and call quota ────────────────────────────────────────────────
# Every stage defaults to OpenRouter's free models router (openrouter/free).
# Pin a stage with AUGUR_MODEL_<STAGE>: one model, or a comma-separated
# fallback chain tried in order within one request (OpenRouter `models`), e.g.
# AUGUR_MODEL_ANCHORING=<vendor>/<model-a>:free,<vendor>/<model-b>:free,openrouter/free
# Free models are often gated or rate-limited upstream; end a chain with
# openrouter/free so the stage keeps running. Check the free list at deploy time.
# Stages: EXTRACTION, ANCHORING, DISCONFIRMATION, PROJECTION, CONVERSATION, DIGEST
#
# Free models allow 1,000 requests a day per OpenRouter ACCOUNT (50 if the
# account has bought less than $10 of credits in total) and 20 a minute.
# Discourse uses the same account; keep the two limits' sum under the quota.
LLM_DAILY_CALL_LIMIT=800
LLM_CALLS_PER_MINUTE=12
# Hourly extraction cap; at 8 calls per payload, 20 = 2 payloads an hour
EXTRACTION_CALLS_PER_RUN=20

# ── Retention ────────────────────────────────────────────────────────────────
# Rejected payloads (exact duplicates, too-short items) are deleted after this
# many days by a daily job; accepted payloads are kept indefinitely.
REJECTED_PAYLOAD_RETENTION_DAYS=30

# ── Historical backfill ──────────────────────────────────────────────────────
# `augur backfill run --days N`: 2026 from archived feeds, newest day first
# (docs/augur-architecture.md, "Historical backfill"). Runs on a paid
# low-cost model, outside the free-tier quota, within its own total cap.
BACKFILL_MODEL=inclusionai/ling-3.0-flash
BACKFILL_BUDGET_USD=4
BACKFILL_REASONING_OFF=true
BACKFILL_PER_DAY=25
BACKFILL_PER_SOURCE_CAP=8

# ── API access ───────────────────────────────────────────────────────────────
# Unset = /api/* is open. Set it once anything beyond the host reaches the API.
# AUGUR_API_KEY=

# ── Application ──────────────────────────────────────────────────────────────
AUGUR_ENV=development
LOG_LEVEL=INFO
# Override to "production" to switch to JSON-only log output
LOG_FORMAT=text
